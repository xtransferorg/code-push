{
  "name": "@xrnjs/react-native-code-push",
  "version": "0.0.1",
  "description": "React Native plugin for the CodePush service",
  "main": "CodePush.js",
  "typings": "typings/react-native-code-push.d.ts",
  "homepage": "https://github.com/xtransferorg/code-push",
  "keywords": [
    "react-native",
    "code",
    "push"
  ],
  "author": "XTransfer",
  "license": "Apache 2.0",
  "harmony": {
    "alias": "react-native-code-push",
    "codegenConfig": {
      "specPaths": [
        "./src"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xtransferorg/code-push"
  },
  "scripts": {
    "watch": "nodemon --ignore dist/  --ignore lib/ --ignore node_modules/ --watch ./ -C -e js,jsx,ts,tsx,css,less --debug -x 'yalc publish'",
    "oh-codegen": "react-native codegen-harmony --cpp-output-path ./harmony/entry/src/main/cpp/generated --rnoh-module-path ./harmony/codePush/oh_modules/@rnoh/react-native-openharmony",
    "ohpm-install": "cd harmony && ohpm install",
    "copy-har": "cp ./harmony/codePush/build/default/outputs/default/codePush.har ./harmony/codePush.har",
    "build-har": "cd harmony && hvigorw --mode module -p product=default -p module=codePush@default assembleHar --analyze=normal --parallel --incremental --daemon",
    "build": "npm run ohpm-install && npm run oh-codegen && npm run build-har && npm run copy-har"
  },
  "dependencies": {
    "@xrnjs/code-push-core": "workspace:*",
    "glob": "^5.0.15",
    "hoist-non-react-statics": "^2.3.1",
    "inquirer": "1.1.2",
    "plist": "3.0.1",
    "semver": "^5.6.0",
    "xcode": "1.0.0"
  },
  "devDependencies": {
    "@react-native-oh/react-native-harmony": "0.72.38",
    "archiver": "latest",
    "body-parser": "latest",
    "code-push-plugin-testing-framework": "file:./code-push-plugin-testing-framework",
    "del": "latest",
    "express": "latest",
    "gulp-insert": "latest",
    "gulp-tslint": "latest",
    "gulp-typescript": "2.12.2",
    "mkdirp": "latest",
    "q": "^1.4.1",
    "run-sequence": "latest",
    "tslint": "^4.3.1",
    "typescript": "^2.1.5",
    "@xrnjs/multi-bundle": "0.0.2-beta.5"
  },
  "peerDependencies": {
    "@xrnjs/multi-bundle": "*"
  },
  "rnpm": {
    "android": {
      "packageInstance": "new CodePush(getResources().getString(R.string.reactNativeCodePush_androidDeploymentKey), getApplicationContext(), BuildConfig.DEBUG)"
    },
    "ios": {
      "sharedLibraries": [
        "libz"
      ]
    },
    "commands": {
      "postlink": "node node_modules/@xrnjs/react-native-code-push/scripts/postlink/run"
    }
  }
}
