{
  "name": "@xrnjs/code-push-server",
  "description": "CodePush service is hotupdate services which adapter react-native-code-push and cordova-plugin-code-push",
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xtransferorg/code-push"
  },
  "keywords": [
    "code-push",
    "react-native",
    "cordova",
    "services",
    "code",
    "push"
  ],
  "author": "XTransfer",
  "bin": {
    "code-push-server": "./bin/www.js",
    "code-push-server-db": "./bin/db.js"
  },
  "engines": {
    "node": ">= 6.0",
    "npm": ">= 3.10.8"
  },
  "scripts": {
    "dev": "npm run build && concurrently npm:dev:tsc npm:dev:run",
    "dev:tsc": "tsc --watch",
    "dev:run": "LOG_LEVEL=debug supervisor -e 'node|js|ts|pug|json' ./bin/www.js",
    "start": "npm run build && export LOCAL_IP=$(ifconfig | grep 'inet ' | grep -v 127.0.0.1 | awk '{print $2}' | head -n 1) && LOG_LEVEL=debug STORAGE_DIR=storage LOCAL_CODE_PUSH_DIR=cache-code-push LOCAL_DOWNLOAD_URL=http://$LOCAL_IP:3000/download DIFF_NUMS=0 node ./bin/www.js",
    "start:oh": "npm run build && LOG_LEVEL=debug STORAGE_DIR=storage LOCAL_DOWNLOAD_URL=http://192.168.69.112:3000/download DIFF_NUMS=0 node ./bin/www.js",
    "start:dev": "npm run build && LOG_LEVEL=debug STORAGE_DIR=storage DIFF_NUMS=0 MYSQL_HOST=dev-mysql.code-push-server.svc.cluster.local MYSQL_USERNAME=codepush MYSQL_PASSWORD=123456 node ./bin/www.js",
    "build": "rm -rf bin && tsc && cp -r src/core/diff bin/core",
    "release": "npm run build && npm test && standard-version && git push --follow-tags origin master && npm publish",
    "release-docker": "make release-docker",
    "test": "yarn build && MYSQL_DATABASE=code_push_test make test",
    "coverage": "yarn build && MYSQL_DATABASE=code_push_test make coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@types/semver": "7.3.10",
    "aliyun-oss-upload-stream": "1.3.0",
    "aliyun-sdk": "1.12.4",
    "archiver": "^7.0.1",
    "aws-sdk": "2.1176.0",
    "bcryptjs": "2.4.3",
    "body-parser": "1.20.0",
    "cookie-parser": "1.4.6",
    "cos-nodejs-sdk-v5": "2.11.12",
    "dayjs": "1.11.13",
    "download": "^8.0.0",
    "express": "4.18.1",
    "extract-zip": "2.0.1",
    "formidable": "2.0.1",
    "fs-extra": "10.1.0",
    "helmet": "5.1.0",
    "i18n": "0.15.0",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.21",
    "moment": "2.29.3",
    "mysql2": "2.3.3",
    "node-fetch": "2.6.7",
    "nodemailer": "6.7.7",
    "pug": "3.0.2",
    "qiniu": "7.7.0",
    "rand-token": "1.0.1",
    "recursive-readdir": "2.2.2",
    "redis": "4.2.0",
    "semver": "^7.6.3",
    "sequelize": "6.21.3",
    "slash": "3.0.0",
    "uuid": "11.0.3",
    "validator": "13.7.0",
    "winston-daily-rotate-file": "5.0.0",
    "yargs": "17.5.1",
    "yazl": "2.5.1"
  },
  "devDependencies": {
    "@shm-open/eslint-config-bundle": "1.9.13",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "2.4.2",
    "@types/body-parser": "1.19.2",
    "@types/cookie-parser": "1.4.3",
    "@types/download": "^8.0.5",
    "@types/express": "^4.17.21",
    "@types/formidable": "2.0.5",
    "@types/fs-extra": "9.0.13",
    "@types/i18n": "0.13.4",
    "@types/jsonwebtoken": "8.5.9",
    "@types/lodash": "4.14.195",
    "@types/node-fetch": "2.6.2",
    "@types/nodemailer": "6.4.5",
    "@types/recursive-readdir": "2.2.1",
    "@types/validator": "13.7.10",
    "@types/yazl": "2.4.2",
    "@xrnjs/code-push-core": "workspace:*",
    "concurrently": "7.4.0",
    "express-winston": "4.2.0",
    "mocha": "10.0.0",
    "nyc": "15.1.0",
    "should": "13.2.3",
    "standard-version": "9.5.0",
    "supertest": "6.2.4",
    "supervisor": "0.12.0",
    "typescript": "4.9.5",
    "winston": "3.13.1"
  },
  "files": [
    "bin",
    "docs",
    "locales",
    "public",
    "sql",
    "views",
    "README.md",
    "LICENSE"
  ]
}
